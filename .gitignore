# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local listing posts when Supabase is not configured
/data/posted-listings.json
/data/education-suggestions.json

# vercel
.vercel

# generated map source downloads
/scripts/cache

# raw logo downloads (regenerate with npm run logos:fetch)
/public/org-logos/_raw

# typescript
*.tsbuildinfo
next-env.d.ts
